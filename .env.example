# VeriFin 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 已在 .gitignore 中排除，切勿提交真实密钥。

# ---------------------------------------------------------------------------
# 索引
# ---------------------------------------------------------------------------
# 持久化索引目录（API 服务与 MCP Server 默认读取位置）
# 留空则使用内置合成语料，无需任何外部数据即可跑通 demo
VERIFIN_INDEX_DIR=./bge_env

# 是否启用 Dense 向量路（0/false 关闭，仅用 BM25）
VERIFIN_DENSE=1

# ---------------------------------------------------------------------------
# 检索与重排
# ---------------------------------------------------------------------------
# Cross-Encoder 重排模型的本地目录路径。
# 设为本地路径可完全离线加载，规避 HuggingFace Hub 的 SSL / 网络阻塞。
# 留空则使用默认模型（ms-marco-MiniLM-L-6-v2）
RERANKER_MODEL=

# 离线模式：1 = 不访问 HuggingFace Hub（模型权重必须已缓存到本地）
HF_HUB_OFFLINE=0

# HuggingFace 镜像（国内网络首次下载模型权重时使用）
# HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------------------
# LLM（可选增强，两条通道二选一；不配置则走确定性规则路径）
# ---------------------------------------------------------------------------
# 通道 A：OpenAI 兼容直连（DeepSeek 等）。推荐用环境变量而非命令行参数传入，
# 避免密钥进入 shell history 与进程列表
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 通道 B：本地桥接服务（scripts/llm_bridge.mjs）
BRIDGE_PORT=8642
MIN_GAP_MS=4000

# ---------------------------------------------------------------------------
# API 服务
# ---------------------------------------------------------------------------
VERIFIN_HOST=127.0.0.1
VERIFIN_PORT=8000
